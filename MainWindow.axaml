<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="drugieokno.MainWindow"
        Title="Warsztat – Bezpieczna szachownica"
        Width="800" Height="450"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Gentle low-contrast checkerboard, filled from code-behind -->
        <Grid x:Name="CheckerBoard" />

        <!-- Readable centered panel -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F2FFFFFF" CornerRadius="12" Padding="24,16"
                BorderBrush="#33000000" BorderThickness="1">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <TextBlock x:Name="MovingText"
                           Text="Warsztat"
                           FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="SubtitleText"
                           Text="Tryb bezpieczny: spokojne kolory i wolny ruch"
                           FontSize="13" Opacity="0.75"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Minimal pause control — required for auto-playing motion (WCAG 2.2.2).
             Kept small in corner instead of center. -->
        <Button x:Name="AnimationToggleButton"
                Content="Stop"
                FontSize="11" Opacity="0.6"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,12,12"
                ToolTip.Tip="Wstrzymaj lub wznów animację (Spacja)"
                TabIndex="0"
                Click="OnToggleAnimationClick"/>
        <TextBlock x:Name="StatusText"
                   Text="Animacja: włączona • 0,4 Hz (bezpiecznie)"
                   FontSize="11" Opacity="0.6"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="12,0,0,12"/>
        <ComboBox x:Name="SpeedSelector"
                  SelectedIndex="0"
                  FontSize="11" Opacity="0.8"
                  HorizontalAlignment="Center" VerticalAlignment="Bottom"
                  Margin="0,0,0,12"
                  ToolTip.Tip="Wybierz bezpieczną prędkość animacji"
                  TabIndex="1"
                  SelectionChanged="OnSpeedSelectionChanged">
            <ComboBoxItem Content="Wolno (1,2 s)"/>
            <ComboBoxItem Content="Bardzo wolno (2,0 s)"/>
        </ComboBox>
    </Grid>
</Window>
